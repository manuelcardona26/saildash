    <!-- Save to USB -->
    <string name="diagnostico_export_title">Save to USB</string>
    <string name="diagnostico_export_help">Saves the report, the recorded events and the key apps\' APKs into a \"SailDash-diagnostico\" folder on every storage it finds: the USB stick and internal storage. If it\'s recording, it stops first.</string>
