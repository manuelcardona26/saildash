<resources>
    <string name="diagnostico_tab">Diagnostics</string>
    <string name="diagnostico_title">Head unit diagnostics</string>
    <string name="diagnostico_intro">Find out how your head unit handles the radio, the equalizer, reverse gear, the lights and the ignition, so a future SailDash version can control them. It only looks: it changes nothing and sends nothing to the internet.</string>
    <string name="diagnostico_checking">Checking your head unit…</string>
    <string name="diagnostico_checking_apps">Checking factory apps (%1$d of %2$d)…</string>
    <string name="diagnostico_check_failed">Couldn\'t check: %1$s</string>
    <string name="diagnostico_recheck">Check again</string>
    <string name="diagnostico_summary">The essentials</string>
    <string name="diagnostico_details_show">Show technical details</string>
    <string name="diagnostico_details_hide">Hide technical details</string>

    <!-- Summary -->
    <string name="diagnostico_android">Your head unit runs Android %1$s (API %2$d).</string>
    <string name="diagnostico_android_fake">The head unit says \"Android %1$s\", but inside it\'s Android %2$s.</string>
    <string name="diagnostico_split_yes">Split screen: yes, it comes turned on.</string>
    <string name="diagnostico_split_forced">Split screen: forced on from Developer options.</string>
    <string name="diagnostico_split_no">Split screen: the maker turned it off. You can try Developer options → \"Force activities to be resizable\" and restart the head unit.</string>
    <string name="diagnostico_split_old">Split screen: no, it arrived with Android 7.</string>
    <string name="diagnostico_eq_yes">Android equalizer: works, with %1$d bands. It applies to app audio (Spotify, AutoKit, NewPipe); the factory radio and Bluetooth go through the MCU.</string>
    <string name="diagnostico_eq_busy">Another app already has the Android equalizer on (maybe the Sound app).</string>
    <string name="diagnostico_eq_no">Android equalizer: not responding. Your head unit\'s equalizer must live in the MCU (Sound app).</string>
    <string name="diagnostico_apps_found">%1$d factory apps; %2$d are key (radio, sound, car, reverse, Bluetooth or MCU).</string>

